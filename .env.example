# ============================================
# Database - Neon PostgreSQL
# ============================================

DATABASE_URL="postgresql://<username>:<password>@<pooler-host>/<database>?sslmode=require"

POSTGRES_DATABASE="<database>"
POSTGRES_DATABASE_URL="postgresql://<username>:<password>@<pooler-host>/<database>?sslmode=require"
POSTGRES_DATABASE_URL_UNPOOLED="postgresql://<username>:<password>@<host>/<database>?sslmode=require"

POSTGRES_HOST="<pooler-host>"
POSTGRES_NEON_PROJECT_ID="<neon-project-id>"

POSTGRES_PASSWORD="<password>"
POSTGRES_PGDATABASE="<database>"
POSTGRES_PGHOST="<pooler-host>"
POSTGRES_PGHOST_UNPOOLED="<host>"
POSTGRES_PGPASSWORD="<password>"
POSTGRES_PGUSER="<username>"

POSTGRES_PRISMA_URL="postgresql://<username>:<password>@<pooler-host>/<database>?connect_timeout=15&sslmode=require"

POSTGRES_URL="postgresql://<username>:<password>@<pooler-host>/<database>?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://<username>:<password>@<host>/<database>?sslmode=require"
POSTGRES_URL_NO_SSL="postgresql://<username>:<password>@<pooler-host>/<database>"

POSTGRES_USER="<username>"

